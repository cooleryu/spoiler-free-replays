{
  "name": "bilibili-replay-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "start": "node --import tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "bilibili:setup": "node scripts/bilibili-setup.mjs",
    "check:local": "node --import tsx scripts/check-local.ts",
    "check:agent": "node --import tsx scripts/check-agent.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xzxzzx/bilibili-mcp": "1.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
